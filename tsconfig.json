{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [".astro/types.d.ts", "**/*", "src/interfaces/**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
