                    "name": "Listar posts",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Content-Type json o cuerpo JSON (CF static puede omitir cabecera)', () => {",
                                    "    const contentType = pm.response.headers.get('Content-Type');",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body).to.be.an('array');",
                                    "    if (contentType) {",
                                    "        pm.expect(contentType).to.include('application/json');",
                                    "    }",
                                    "});",
                                    "pm.test('array con los 5 slugs del blog', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body).to.be.an('array');",
                                    "    pm.expect(body.length).to.be.at.least(5);",
                                    "    const ids = body.map((post) => post.id);",
                                    "    pm.expect(ids).to.include.members([",
                                    "        'first-post',",
                                    "        'second-post',",
                                    "        'third-post',",
                                    "        'markdown-style-guide',",
                                    "        'using-mdx'",
                                    "    ]);",
                                    "});"
                                ]
                            }
                        }
                    ],
