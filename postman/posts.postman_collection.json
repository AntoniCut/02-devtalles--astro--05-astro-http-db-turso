            "name": "02 — Creación",
            "item": [
                {
                    "name": "Crear post",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 201', () => pm.response.to.have.status(201));",
                                    "pm.test('eco del body con method POST', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body.method).to.eql('POST');",
                                    "    pm.expect(body.title).to.eql('Nuevo post');",
                                    "    pm.expect(body.description).to.eql('Descripción de prueba');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Nuevo post\",\n    \"description\": \"Descripción de prueba\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/posts/mutate",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "posts", "mutate"]
                        },
                        "description": "Simula la creación de un post (demo, sin persistencia)."
                    },
                    "response": []
