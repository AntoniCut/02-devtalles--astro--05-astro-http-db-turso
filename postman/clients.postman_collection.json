{
    "info": {
        "_postman_id": "a1b2c3d4-clients-05-astro-http-db-turso",
        "name": "05-astro-http-db-turso — Clients",
        "description": "CRUD de la tabla Clients (Astro DB + Turso).\n\nRequiere runtime con Turso (`pnpm dev --remote` o Cloudflare Worker).\n\nEl flujo feliz crea un cliente de prueba, lo actualiza y lo borra. No muta los ids seed 1–5.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:4321"
        },
        {
            "key": "testClientId",
            "value": ""
        },
        {
            "key": "seedClientId",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "01 — Lectura",
            "item": [
                {
                    "name": "Listar clientes",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Content-Type json', () => {",
                                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                                    "});",
                                    "pm.test('array con seed 1-5', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body).to.be.an('array');",
                                    "    pm.expect(body.length).to.be.at.least(5);",
                                    "    const ids = body.map((client) => client.id);",
                                    "    pm.expect(ids).to.include.members([1, 2, 3, 4, 5]);",
                                    "    const john = body.find((client) => client.id === 1);",
                                    "    pm.expect(john).to.include({ name: 'John Doe', age: 30, isActive: true });",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/clients"
                        },
                        "description": "Devuelve todos los registros de la tabla Clients."
                    },
                    "response": []
                },
                {
                    "name": "Obtener cliente seed por id",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('cliente seed id 1', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body).to.include({",
                                    "        id: 1,",
                                    "        name: 'John Doe',",
                                    "        age: 30,",
                                    "        isActive: true",
                                    "    });",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/clients/{{seedClientId}}"
                        },
                        "description": "Lee el cliente seed id 1. No usa clientId para no chocar con el cliente de prueba."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "02 — Creación",
            "item": [
                {
                    "name": "Crear cliente",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 201', () => pm.response.to.have.status(201));",
                                    "pm.test('cliente creado y clientId capturado', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body.id).to.be.a('number');",
                                    "    pm.expect(body.id).to.be.above(5);",
                                    "    pm.expect(body).to.include({",
                                    "        name: 'Postman Test Client',",
                                    "        age: 29,",
                                    "        isActive: true",
                                    "    });",
                                    "    pm.collectionVariables.set('testClientId', String(body.id));",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Postman Test Client\",\n    \"age\": 29,\n    \"isActive\": true\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/clients"
                        },
                        "description": "Inserta un cliente de prueba y guarda su id en clientId. No toca los seed 1–5."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "03 — Actualización",
            "item": [
                {
                    "name": "Reemplazar cliente (PUT)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const clientId = Number(pm.collectionVariables.get('testClientId'));",
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('cliente reemplazado', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body).to.include({",
                                    "        id: clientId,",
                                    "        name: 'Postman Test Client',",
                                    "        age: 30,",
                                    "        isActive: false",
                                    "    });",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Postman Test Client\",\n    \"age\": 30,\n    \"isActive\": false\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/clients/{{testClientId}}"
                        },
                        "description": "Actualiza todos los campos del cliente de prueba."
                    },
                    "response": []
                },
                {
                    "name": "Actualizar cliente parcial (PATCH)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const clientId = Number(pm.collectionVariables.get('testClientId'));",
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('isActive actualizado a true', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body).to.include({",
                                    "        id: clientId,",
                                    "        name: 'Postman Test Client',",
                                    "        age: 30,",
                                    "        isActive: true",
                                    "    });",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"isActive\": true\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/clients/{{testClientId}}"
                        },
                        "description": "Actualiza solo isActive del cliente de prueba."
                    },
                    "response": []
                },
                {
                    "name": "Obtener cliente creado",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const clientId = Number(pm.collectionVariables.get('testClientId'));",
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('GET refleja el PATCH', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body).to.include({",
                                    "        id: clientId,",
                                    "        name: 'Postman Test Client',",
                                    "        age: 30,",
                                    "        isActive: true",
                                    "    });",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/clients/{{testClientId}}"
                        },
                        "description": "Confirma que el cliente de prueba quedó persistido tras PUT/PATCH."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "04 — Eliminación",
            "item": [
                {
                    "name": "Eliminar cliente",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const clientId = Number(pm.collectionVariables.get('testClientId'));",
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('mensaje DELETE', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body.method).to.eql('DELETE');",
                                    "    pm.expect(body.id).to.eql(clientId);",
                                    "    pm.expect(body.message).to.eql('Client \"' + clientId + '\" deleted');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Origin",
                                "value": "{{baseUrl}}",
                                "description": "Evita 403 CSRF en dev. Debe coincidir con la URL (localhost, no 127.0.0.1)."
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/clients/{{testClientId}}"
                        },
                        "description": "Borra el cliente de prueba. No requiere body."
                    },
                    "response": []
                }
            ]
        },
