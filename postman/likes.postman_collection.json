        {
            "name": "02 — Crear post (Turso)",
            "item": [
                {
                    "name": "POST crear post (Turso)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('respuesta Ok', () => {",
                                    "    pm.expect(pm.response.text()).to.eql('Ok!');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"likes\": 10\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/posts/likes/{{newPostId}}"
                        },
                        "description": "Inserta el post en la tabla Posts si no existe e incrementa likes. Cambia newPostId para otro id."
                    },
                    "response": []
                },
                {
                    "name": "GET verificar post creado",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('post creado en Turso', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body.id).to.eql(pm.collectionVariables.get('newPostId'));",
                                    "    pm.expect(body.likes).to.be.a('number');",
                                    "    pm.expect(body.title).to.be.a('string');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/posts/likes/{{newPostId}}"
                        },
                        "description": "Ejecutar después del POST para comprobar el registro en Turso."
                    },
                    "response": []
                }
            ]
