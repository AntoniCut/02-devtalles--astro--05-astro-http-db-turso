            "name": "01 — Lectura",
            "item": [
                {
                    "name": "GET /api/posts/likes/{{postSlug}}",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('post con id, title y likes', () => {",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(body.id).to.eql(pm.variables.get('postSlug'));",
                                    "    pm.expect(body.title).to.be.a('string');",
                                    "    pm.expect(body.likes).to.be.a('number');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/posts/likes/{{postSlug}}"
                        },
                        "description": "GET /api/posts/likes/:slug con un id de la tabla Posts. Respuesta 200: { id, title, likes }."
