---

/*
    *  --------------------------------------------------------------------------  *
    *  -----  FormattedDate.astro  --  /src/components/FormattedDate.astro  -----  *
    *  --------------------------------------------------------------------------  *
 */



/**
 * -----------------------------------
 * -----  interface  -  `Props`  -----
 * -----------------------------------
 * - `props de la fecha formateada`
 */
interface Props {

    /** - `fecha a formatear` */
    date: Date;
}



/** - `fecha a formatear` */
const { date } = Astro.props;

---

<time datetime={date.toISOString()}>
    {date.toLocaleDateString("en-us", {
        year: "numeric",
        month: "short",
        day: "numeric",
    })}
</time>
