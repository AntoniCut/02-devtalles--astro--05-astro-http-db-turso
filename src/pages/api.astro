---

/*
    *  ---------------------------------------------------  *
    *  -----  api.astro  --  /src/pages/api.astro  -----  *
    *  ---------------------------------------------------  *
 */

 
import BaseHead from "@/src/components/BaseHead.astro";
import Footer from "@/src/components/Footer.astro";
import Header from "@/src/components/Header.astro";
import { API_SECTIONS } from "@/src/data/api-endpoints";
import { SITE_TITLE } from "@/src/consts";


/** - `título de la página de documentación api` */
const pageTitle = `API — ${SITE_TITLE}`;

/** - `descripción de la página de documentación api` */
const pageDescription =
    "Documentación de los endpoints HTTP del proyecto con todos los casos de uso.";

---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={pageTitle} description={pageDescription} />
    </head>
    <body>
        <Header />

        <main>
            <header class="page-header">
                <h1>API HTTP</h1>
                <p>
                    Referencia de endpoints del proyecto. Los GET estáticos se
                    pueden probar desde los enlaces. Las mutaciones requieren
                    Postman o curl con body JSON.
                </p>
            </header>

            <nav class="api-nav" aria-label="Secciones de la API">
                <a href="#posts">Posts</a>
                <a href="#clients">Clients</a>
            </nav>

            {API_SECTIONS.map((section) => (
                <section id={section.id} class="api-section">
                    <header class="section-header">
                        <h2>{section.title}</h2>
                        <p>{section.description}</p>
                    </header>

                    {section.useCases.map((useCase) => (
                        <section class="use-case">
                            <h3>{useCase.title}</h3>
                            <p>{useCase.description}</p>

                            <ul class="endpoint-list">
                                {useCase.endpoints.map((endpoint) => (
                                    <li class="endpoint-card">
                                        <div class="endpoint-header">
                                            <span
                                                class={`method method-${endpoint.method.toLowerCase()}`}
                                            >
                                                {endpoint.method}
                                            </span>
                                            <span class="mode">
                                                {endpoint.mode === "static"
                                                    ? "estático"
                                                    : "SSR"}
                                            </span>
                                        </div>

                                        <h4>{endpoint.title}</h4>
                                        <p>{endpoint.description}</p>

                                        {endpoint.method === "GET" &&
                                        endpoint.relatedLinks &&
                                        endpoint.relatedLinks.length > 0 ? (
                                            <>
                                                <p>
                                                    <code>{endpoint.path}</code>
                                                </p>
                                                <ul class="related-links">
                                                    {endpoint.relatedLinks.map(
                                                        (link) => (
                                                            <li>
                                                                <a
                                                                    href={
                                                                        link.path
                                                                    }
                                                                >
                                                                    {link.label}
                                                                </a>
                                                            </li>
                                                        ),
                                                    )}
                                                </ul>
                                            </>
                                        ) : endpoint.method === "GET" ? (
                                            <p>
                                                <a href={endpoint.path}>
                                                    {endpoint.path}
                                                </a>
                                            </p>
                                        ) : (
                                            <p>
                                                <code>{endpoint.path}</code>
                                            </p>
                                        )}

                                        {endpoint.bodyExample && (
                                            <figure>
                                                <figcaption>
                                                    Body JSON
                                                </figcaption>
                                                <pre>
                                                    <code>
                                                        {
                                                            endpoint.bodyExample
                                                        }
                                                    </code>
                                                </pre>
                                            </figure>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    ))}
                </section>
            ))}
        </main>

        <Footer />
    </body>
</html>

<style>
    main {
        width: min(960px, 100%);
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
    }

    .page-header {
        margin-bottom: 2.5rem;
    }

    .page-header p {
        color: rgb(var(--gray));
        max-width: 42rem;
    }

    .api-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.25rem;
        margin-bottom: 2.5rem;
        padding: 1rem 1.25rem;
        border: 1px solid rgba(var(--gray), 25%);
        border-radius: 12px;
        background: white;
    }

    .api-nav a {
        color: var(--accent);
        font-weight: 700;
        text-decoration: none;
    }

    .api-nav a:hover {
        text-decoration: underline;
    }

    .api-section {
        margin-bottom: 4rem;
        scroll-margin-top: 1.5rem;
    }

    .section-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid rgba(var(--accent), 35%);
    }

    .section-header h2 {
        margin: 0 0 0.5rem;
        font-size: 1.75rem;
    }

    .section-header p {
        margin: 0;
        color: rgb(var(--gray));
        max-width: 42rem;
    }

    .use-case {
        margin-bottom: 2.5rem;
    }

    .use-case h3 {
        margin-bottom: 0.5rem;
        font-size: 1.2rem;
    }

    .use-case > p {
        color: rgb(var(--gray));
        margin-bottom: 1.25rem;
    }

    .endpoint-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1rem;
    }

    .endpoint-card {
        border: 1px solid rgba(var(--gray), 25%);
        border-radius: 12px;
        padding: 1.25rem;
        background: white;
    }

    .endpoint-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .method {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .method-get {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .method-post {
        background: #e3f2fd;
        color: #1565c0;
    }

    .method-put {
        background: #fff3e0;
        color: #ef6c00;
    }

    .method-patch {
        background: #f3e5f5;
        color: #7b1fa2;
    }

    .method-delete {
        background: #ffebee;
        color: #c62828;
    }

    .mode {
        font-size: 0.8rem;
        color: rgb(var(--gray));
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .endpoint-card h4 {
        margin: 0 0 0.5rem;
        font-size: 1.1rem;
    }

    .endpoint-card p {
        margin: 0 0 0.75rem;
    }

    .endpoint-card a {
        word-break: break-all;
    }

    .related-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .related-links a {
        font-size: 0.95rem;
    }

    figure {
        margin: 0;
    }

    figcaption {
        font-size: 0.85rem;
        color: rgb(var(--gray));
        margin-bottom: 0.35rem;
    }

    pre {
        margin: 0;
        padding: 1rem;
        border-radius: 8px;
        background: rgb(var(--gray-light));
        overflow-x: auto;
    }

    code {
        font-size: 0.9rem;
    }
</style>
