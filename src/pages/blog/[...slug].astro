---

/*
    *  ------------------------------------------------------------------  *
    *  -----  [...slug].astro  --  /src/pages/blog/[...slug].astro  -----  *
    *  ------------------------------------------------------------------  *
 */

import type { GetStaticPaths } from "astro";
import BlogPost from "@/src/layouts/BlogPost.astro";
import { LIKES_USE_SERVER_ACTIONS } from "@/src/consts";
import LikeCounter from "@/src/components/likes/LikeCounter.vue";
import LikeCounterAction from "@/src/components/likes/LikeCounterAction.vue";
import { getCollection, render, type CollectionEntry } from "astro:content";


/**
 * ------------------------------
 * -----  type  -  `Props`  -----
 * ------------------------------
 * - `post de la colección blog`
 * */
type Props = CollectionEntry<"blog">;

/**
 * --------------------------------
 * -----  `getStaticPaths()`  -----
 * --------------------------------
 * - Genera una ruta estática por cada post del blog.
 */
export const getStaticPaths = (async () => {

    /** - `posts de la colección blog` */
    const posts = await getCollection("blog");

    //  -----  devolver una ruta por cada post  -----
    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));

}) satisfies GetStaticPaths;



/** - `post resuelto para esta ruta` */
const post = Astro.props;

/** - `componente de contenido renderizado del post` */
const { Content } = await render(post);

---

<BlogPost {...post.data} id={post.id}>
    {LIKES_USE_SERVER_ACTIONS ? (
        <LikeCounterAction client:only="vue" postId={post.id} />
    ) : (
        <LikeCounter client:only="vue" postId={post.id} />
    )}

    <Content />
</BlogPost>
