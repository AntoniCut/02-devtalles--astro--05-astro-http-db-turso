---

/*
    *  ------------------------------------------------------------------  *
    *  -----  [...slug].astro  --  /src/pages/blog/[...slug].astro  -----  *
    *  ------------------------------------------------------------------  *
 */

import type { GetStaticPaths } from "astro";
import BlogPost from "@/src/layouts/BlogPost.astro";
import { LIKES_USE_SERVER_ACTIONS } from "@/src/consts";
import LikeCounter from "@/src/components/likes/LikeCounter.vue";
import LikeCounterAction from "@/src/components/likes/LikeCounterAction.vue";
import { getCollection, render, type CollectionEntry } from "astro:content";


export const getStaticPaths = (async () => {
    
    const posts = await getCollection("blog");

    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));

}) satisfies GetStaticPaths;


type Props = CollectionEntry<"blog">;


const post = Astro.props;

const { Content } = await render(post);

---


<BlogPost {...post.data} id={post.id}>
    
    {
        LIKES_USE_SERVER_ACTIONS ? (
            <LikeCounterAction client:only="vue" postId={post.id} />
        ) : (
            <LikeCounter client:only="vue" postId={post.id} />
        )
    }
        
    <Content />
    
</BlogPost>
