{
    "name": "05-astro-http-db-turso",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scriptsDoc": {
        "dev:local": "Servidor en :4321 con SQLite local (.astro/content.db), sin Turso. Usa Node (no worker Cloudflare) para que libSQL pueda leer file:.",
        "db:push:local": "Sincroniza el esquema de db/config.ts en .astro/content.db (sin --remote).",
        "db:seed:local": "Ejecuta db/seed.dev.ts en la base local (Clients + Posts).",
        "dev": "Servidor en :4321 con Turso (--remote). Mismo destino que producción en dev. Requiere .env.",
        "db:push": "Sincroniza el esquema de db/config.ts en Turso (--remote).",
        "db:seed": "Ejecuta db/seed.dev.ts en Turso (--remote).",
        "build:remote": "Build de producción contra Turso (--remote) → ./dist/.",
        "deploy": "build:remote + wrangler deploy a Cloudflare Workers.",
        "preview": "Previsualiza el último build en :4322.",
        "build": "astro build sin --remote. Con Cloudflare + Astro DB suele fallar; no desplegar con esto.",
        "astro": "CLI de Astro (pnpm astro …).",
        "format": "Formatea JS/TS/Astro con Prettier y scripts/post-prettier-style.mjs.",
        "format:check": "Comprueba formato sin modificar archivos."
    },
    "scripts": {
        "dev:local": "astro dev --port 4321 --open",
        "db:push:local": "astro db push",
        "db:seed:local": "astro db execute db/seed.dev.ts",
        "dev": "astro dev --remote --port 4321 --open",
        "db:push": "astro db push --remote",
        "db:seed": "astro db execute db/seed.dev.ts --remote",
        "build:remote": "astro build --remote",
        "deploy": "pnpm build:remote && wrangler deploy",
        "preview": "astro preview --port 4322 --open",
        "build": "astro build",
        "astro": "astro",
        "format": "prettier --write \"**/*.{js,ts,astro,mjs}\" && node scripts/post-prettier-style.mjs",
        "format:check": "prettier --check \"**/*.{js,ts,astro,mjs}\""
    },
    "dependencies": {
        "@astrojs/cloudflare": "^13.7.0",
        "@astrojs/db": "^0.21.3",
        "@astrojs/mdx": "^6.0.3",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@astrojs/vue": "^7.0.3",
        "astro": "^6.4.8",
        "canvas-confetti": "^1.9.4",
        "lodash-es": "^4.18.1",
        "lodash.debounce": "^4.0.8",
        "sharp": "^0.35.0",
        "vue": "^3.5.43",
        "wrangler": "^4.131.2"
    },
    "allowScripts": {
        "esbuild": true,
        "workerd": true
    },
    "devDependencies": {
        "@types/canvas-confetti": "^1.9.0",
        "@types/lodash-es": "^4.17.12",
        "@types/lodash.debounce": "^4.0.9",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^1.0.0",
        "typescript": "^5.8.3"
    }
}
